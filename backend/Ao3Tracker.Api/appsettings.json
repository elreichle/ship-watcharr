{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DataDirectory": "appdata"
  },
  "Database": {
    "Provider": "Sqlite",
    "PostgresConnectionString": ""
  },
  "Ao3HttpClient": {
    "MinDelayBetweenRequests": "00:00:05",
    "MaxDelayBetweenRequests": "00:00:08",
    "CacheDuration": "00:15:00",
    "MaxRetries": 3,
    "InitialBackoff": "00:00:10",
    "BackoffJitterFactor": 0.2,
    "MaxConsecutiveFailures": 3,
    "MaxRequestsPerRun": 500,
    "MaxRunDuration": "02:00:00",
    "ProductToken": "ShipWatcharr/0.1",

    "//OperatorContact": [
      "Intentionally absent, so no personal detail is committed to this repository and the",
      "project's author is never the contact for someone else's instance.",
      "Falls back to the first admin's email, which is optional and saved at Settings -> Account.",
      "To override:  Settings -> Scraping in the app (applies immediately, no restart), or",
      "  Local:  dotnet user-secrets set \"Ao3HttpClient:OperatorContact\" \"you@example.com\"",
      "  Docker: set AO3_OPERATOR_CONTACT in .env"
    ]
  }
}
