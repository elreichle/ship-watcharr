# Copy to .env and fill in real values before running `docker compose up`.

# Sent as the User-Agent on every scrape request. AO3 is volunteer-run infrastructure —
# identify your tool and provide a real way to reach you. Required.
AO3_USER_AGENT=Ao3TrackerBot/0.1 (self-hosted personal scrape tool; contact: you@example.com)

# Minimum spacing enforced between scrape requests (HH:MM:SS). Do not lower this without
# a good reason.
AO3_MIN_DELAY=00:00:05

# Host port the app is published on.
APP_PORT=8080

# --- Only needed if you also use docker-compose.postgres.yml to pre-configure ---
# --- PostgreSQL instead of SQLite (the default). See README. ---
POSTGRES_USER=ao3tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ao3tracker
