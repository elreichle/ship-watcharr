# Copy to .env and fill in real values before running `docker compose up`.

# How AO3 can reach YOU, the person running this copy — an email address or a project URL.
# Required: scraping stays disabled until it is set.
#
# This is not a login and not a secret; it is a public label attached to every request, so that
# AO3's volunteers can ask you to slow down instead of blocking you. It is per-deployment on
# purpose — the project's author must never be the contact for your instance, or yours for
# anyone else's. .env is gitignored, so this never reaches the repository.
AO3_OPERATOR_CONTACT=you@example.com

# Spacing between scrape requests (HH:MM:SS). Each delay is drawn at random from this range,
# which raises the average above the floor and stops multiple instances falling into lockstep.
# Do not lower these without a good reason.
AO3_MIN_DELAY=00:00:05
AO3_MAX_DELAY=00:00:08

# Host port the app is published on.
APP_PORT=8080

# --- Only needed if you also use docker-compose.postgres.yml to pre-configure ---
# --- PostgreSQL instead of SQLite (the default). See README. ---
POSTGRES_USER=shipwatcharr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shipwatcharr
